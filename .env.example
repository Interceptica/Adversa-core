# Adversa environment variables
# Copy this file to .env and fill in your values.
#
# Provider API key — set the one matching your adversa.toml [provider] config:
NOVITA_API_KEY=your_novita_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional overrides (defaults come from adversa.toml)
# ADVERSA_PROVIDER=openai_compatible
# ADVERSA_MODEL=deepseek/deepseek-v3.2
